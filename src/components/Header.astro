---
// Header.astro
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Our Inspiration', href: '/our_inspiration' },
  { label: 'About Us', href: '/about_us' },
  { label: 'Photo Gallery', href: '/photo_gallery' },
  { label: 'Newsletters', href: '/newsletters' },
];
const currentPath = Astro.url.pathname;
---

<header class="bg-white/95 backdrop-blur-md sticky top-0 z-50 border-b border-gray-100 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center py-4 md:justify-start md:space-x-10">
      <div class="flex justify-start lg:w-0 lg:flex-1 items-center gap-3">
        <a href="/" class="flex items-center gap-3 group">
          <img class="h-12 md:h-14 w-auto object-contain transition-transform duration-300 group-hover:scale-105" src="/assets/images/logo.jpg" alt="SPCF Logo" />
          <div class="hidden sm:block">
            <h1 class="text-xl md:text-2xl font-bold text-blue-900 leading-tight tracking-tight uppercase">
              Shashvat Paediatric<br/>
              <span class="text-[var(--color-primary)] font-extrabold">Care Foundation</span>
            </h1>
          </div>
        </a>
      </div>
      
      <!-- Mobile menu button -->
      <div class="-mr-2 -my-2 md:hidden">
        <button id="mobile-menu-btn" type="button" class="bg-white/50 rounded-full p-2.5 inline-flex items-center justify-center text-slate-500 hover:text-[var(--color-primary)] hover:bg-[var(--color-primary-soft)] focus:outline-none focus:ring-2 focus:ring-inset focus:ring-[var(--color-primary)] transition-colors" aria-expanded="false">
          <span class="sr-only">Open menu</span>
          <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex space-x-8 lg:space-x-10">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (currentPath !== '/' && item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a href={item.href} class={`text-base font-bold transition-colors duration-200 relative group ${isActive ? 'text-[var(--color-primary)]' : 'text-blue-900 hover:text-[var(--color-primary)]'}`}>
              {item.label}
              <span class={`absolute -bottom-1 left-0 h-0.5 bg-[var(--color-primary)] transition-all duration-300 ${isActive ? 'w-full' : 'w-0 group-hover:w-full'}`}></span>
            </a>
          );
        })}
      </nav>
      
      <!-- Donate Button -->
      <div class="hidden md:flex items-center justify-end">
        <a href="/contact_us" class="whitespace-nowrap inline-flex items-center justify-center px-6 py-3 border border-transparent rounded-full shadow-lg shadow-orange-500/30 text-base font-bold text-white bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] hover:shadow-xl hover:shadow-orange-500/40 transition-all duration-300 transform hover:-translate-y-0.5">
          Donate Now
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile menu, show/hide based on menu state. -->
  <div class="md:hidden hidden bg-white border-t border-orange-50 absolute w-full shadow-xl" id="mobile-menu">
    <div class="px-4 pt-4 pb-6 space-y-2">
      {navItems.map((item) => (
        <a href={item.href} class="block px-4 py-3 rounded-xl text-base font-semibold text-slate-700 hover:text-[var(--color-primary)] hover:bg-[var(--color-primary-soft)] transition-colors">
          {item.label}
        </a>
      ))}
      <a href="/contact_us" class="block w-full text-center mt-6 px-5 py-4 border border-transparent rounded-xl shadow text-base font-bold text-white bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] transition-colors">
        Donate Now
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
