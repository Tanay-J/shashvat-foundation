---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contribute | Shashvat Paediatric Care Foundation">
  <!-- Page Header -->
  <div class="relative bg-slate-950 py-8 sm:py-10 overflow-hidden border-b border-orange-900/30">
    <div class="absolute inset-0 bg-[url('/assets/images/tmh.jpg')] bg-cover bg-center opacity-10 mix-blend-luminosity"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/80 to-transparent"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 font-bold text-xs mb-4 uppercase tracking-widest backdrop-blur-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-pulse"></span>
        Make a Difference
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-4">Contribute</h1>
      <p class="text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">Your generosity becomes the driving force behind hope, healing, and a brighter future.</p>
    </div>
  </div>

  <section class="py-24 bg-orange-50/50 relative overflow-hidden">
    <div class="absolute top-0 left-0 w-1/3 h-full bg-gradient-to-b from-orange-100/50 to-transparent -skew-x-12 transform origin-top -translate-x-20"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Quote -->
      <div class="bg-white border-l-4 border-orange-500 rounded-r-2xl p-10 mb-20 shadow-xl shadow-orange-900/5 relative overflow-hidden group">
        <div class="absolute right-0 top-0 w-32 h-32 bg-orange-50 rounded-full blur-2xl transform translate-x-1/2 -translate-y-1/2 group-hover:scale-150 transition-transform duration-700"></div>
        <svg class="h-12 w-12 text-orange-200 mb-6 relative z-10" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" /></svg>
        <p class="text-2xl font-medium text-slate-700 italic leading-relaxed relative z-10">
          Shashvat Paediatric Care Foundation is not just an organization; it is a labour of love, born from compassion and a promise to make every contribution truly count. We ensure that 100% of your donation goes directly towards the treatment and welfare of underprivileged children. With no overhead expenses, we uphold a commitment to complete transparency and dedication to our cause.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Donate Details -->
        <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden transform transition duration-500 hover:-translate-y-2 group hover:shadow-2xl hover:shadow-orange-900/10">
          <div class="bg-[var(--color-primary)] px-8 py-6 relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-r from-orange-600 to-[var(--color-primary)] opacity-50 mix-blend-overlay"></div>
            <h2 class="text-2xl font-bold text-white flex items-center relative z-10">
              <svg class="w-7 h-7 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              Donate to Us
            </h2>
          </div>
          <div class="p-10">
            <h3 class="text-2xl font-bold text-slate-900 mb-8">Shashvat Paediatric Care Foundation</h3>
            <div class="space-y-6 text-lg text-slate-700">
              <div class="flex flex-col sm:flex-row sm:items-center p-4 bg-slate-50 rounded-2xl border border-slate-100">
                <span class="font-bold w-40 text-slate-900 mb-2 sm:mb-0">Bank:</span>
                <span class="font-medium">SBI, Jaiprakash Nagar, Nagpur</span>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-center p-4 bg-orange-50 rounded-2xl border border-orange-100/50">
                <span class="font-bold w-40 text-slate-900 mb-2 sm:mb-0">Account No:</span>
                <span class="font-mono text-xl font-bold text-orange-700">40646861774</span>
              </div>
              <div class="flex flex-col sm:flex-row sm:items-center p-4 bg-orange-50 rounded-2xl border border-orange-100/50">
                <span class="font-bold w-40 text-slate-900 mb-2 sm:mb-0">IFSC Code:</span>
                <span class="font-mono text-xl font-bold text-orange-700">SBIN0009058</span>
              </div>
            </div>
            <div class="mt-10 pt-8 border-t border-slate-100">
              <p class="text-slate-500 text-sm font-medium flex items-center">
                 <svg class="w-5 h-5 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                 All donations are securely routed directly to our cause. Thank you for your support.
              </p>
            </div>
          </div>
        </div>

        <!-- Contact Info -->
        <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden transform transition duration-500 hover:-translate-y-2 group hover:shadow-2xl hover:shadow-orange-900/10">
          <div class="bg-slate-900 px-8 py-6 relative overflow-hidden">
             <div class="absolute inset-0 bg-gradient-to-r from-slate-900 to-slate-800 opacity-50 mix-blend-overlay"></div>
            <h2 class="text-2xl font-bold text-white flex items-center relative z-10">
              <svg class="w-7 h-7 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              Contact Us
            </h2>
          </div>
          <div class="p-10">
            <ul class="space-y-8">
              <li class="flex items-start">
                <div class="flex-shrink-0 mt-1">
                  <div class="flex items-center justify-center w-12 h-12 rounded-2xl bg-orange-50 text-orange-600 group-hover:scale-110 group-hover:bg-orange-100 transition-all duration-300">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                  </div>
                </div>
                <div class="ml-6">
                  <h4 class="text-xl font-bold text-slate-900">Address</h4>
                  <p class="mt-2 text-slate-600 leading-relaxed font-medium">Shashvat Paediatric Care Foundation<br/>Plot no: 51, Narkesari Layout<br/>Jaiprakash Nagar, Khamla, Nagpur-440025</p>
                </div>
              </li>
              <li class="flex items-start">
                <div class="flex-shrink-0 mt-1">
                  <div class="flex items-center justify-center w-12 h-12 rounded-2xl bg-orange-50 text-orange-600 group-hover:scale-110 group-hover:bg-orange-100 transition-all duration-300">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                  </div>
                </div>
                <div class="ml-6">
                  <h4 class="text-xl font-bold text-slate-900">Phone</h4>
                  <p class="mt-2 text-slate-600 font-medium"><a href="tel:+917666314967" class="hover:text-orange-600 transition-colors">+91-7666314967</a></p>
                </div>
              </li>
              <li class="flex items-start">
                <div class="flex-shrink-0 mt-1">
                  <div class="flex items-center justify-center w-12 h-12 rounded-2xl bg-orange-50 text-orange-600 group-hover:scale-110 group-hover:bg-orange-100 transition-all duration-300">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                  </div>
                </div>
                <div class="ml-6">
                  <h4 class="text-xl font-bold text-slate-900">Email</h4>
                  <p class="mt-2 text-slate-600 font-medium"><a href="mailto:shashvatpaediatriccare@gmail.com" class="hover:text-orange-600 transition-colors">shashvatpaediatriccare@gmail.com</a></p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>
