---
import Layout from '../layouts/Layout.astro';

// We define our gallery sections to map over them and keep the code DRY
const galleries = [
  {
    title: "Latest Updates",
    images: [
      { src: "/assets/images/recent_campaigns/TMH-Annual-Event-0.jpeg", alt: "Tata Memorial Hospital Annual Event" },
      { src: "/assets/images/recent_campaigns/TMH-Annual-Event-1.jpeg", alt: "Tata Memorial Hospital Annual Event" },
      { src: "/assets/images/recent_campaigns/TMH-Annual-Event-2.jpeg", alt: "Tata Memorial Hospital Annual Event" },
      { src: "/assets/images/recent_campaigns/TMH-Annual-Event-3.jpeg", alt: "Tata Memorial Hospital Annual Event" }
    ]
  },
  {
    title: "Our Credentials & Recognitions",
    images: [
      { src: "/assets/images/creds_recog/trophy.png", alt: "Trophy" },
      { src: "/assets/images/creds_recog/SPCF-Registration.jpeg", alt: "SPCF Registration" },
      { src: "/assets/images/creds_recog/impaCCT.png", alt: "impaCCT Foundation" },
      { src: "/assets/images/creds_recog/spcf.jpg", alt: "SPCF" },
      { src: "/assets/images/creds_recog/NCI-contribution-letter.jpeg", alt: "NCI Contribution Letter" }
    ]
  },
  {
    title: "Tata Memorial Hospital - Paediatric Section",
    images: [
      { src: "/assets/images/tmh.jpg", alt: "Tata Memorial Hospital" },
      { src: "/assets/images/Donation-Shalini Madam-TMH.jpeg", alt: "Donation at TMH" }
    ]
  },
  {
    title: "National Cancer Institute, Nagpur & Cancer Hospital, Ahmedabad",
    images: [
      { src: "/assets/images/nci-ngp.jpg", alt: "National Cancer Institute, Nagpur" },
      { src: "/assets/images/NCI-contribution-letter-1.jpeg", alt: "NCI Contribution Letter" }
    ]
  },
  {
    title: "Sant Gadge Baba Dharmashala, Sion (W), Mumbai",
    images: [
      { src: "/assets/images/sgbd.jpg", alt: "Sant Gadge Baba Dharmashala" },
      { src: "/assets/images/SGB.jpeg", alt: "Sant Gadge Baba Dharmashala" }
    ]
  }
];
---

<Layout title="Photo Gallery | Shashvat Paediatric Care Foundation">
  <!-- Page Header -->
  <div class="relative bg-slate-950 py-8 sm:py-10 overflow-hidden border-b border-orange-900/30">
    <div class="absolute inset-0 bg-[url('/assets/images/tmh.jpg')] bg-cover bg-center opacity-10 mix-blend-luminosity"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/80 to-transparent"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 font-bold text-xs mb-4 uppercase tracking-widest backdrop-blur-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-pulse"></span>
        Moments & Memories
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-4">Photo Gallery</h1>
      <p class="text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">Glimpses of our events, campaigns, and the beautiful smiles we strive to protect.</p>
    </div>
  </div>

  <section class="py-24 bg-orange-50/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-24">
      
      {galleries.map(gallery => (
        <div class="relative">
          <div class="flex items-center gap-4 mb-10">
            <h2 class="text-3xl font-bold text-slate-900">{gallery.title}</h2>
            <div class="flex-grow h-px bg-gradient-to-r from-orange-200 to-transparent ml-4"></div>
          </div>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            {gallery.images.map(image => (
              <button
                type="button"
                class="gallery-image group relative bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl hover:shadow-orange-900/10 transition-all duration-500 border border-slate-100 text-left focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:ring-offset-4"
                data-full-src={image.src}
                data-alt={image.alt}
                aria-label={`View ${image.alt} full size`}
              >
                <div class="aspect-w-4 aspect-h-3 w-full bg-slate-50">
                  <img 
                    src={image.src} 
                    alt={image.alt} 
                    class="w-full h-64 object-cover transform group-hover:scale-110 transition-transform duration-700" 
                  />
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-orange-900/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                <div class="absolute inset-0 border-2 border-orange-500/0 group-hover:border-orange-500/50 rounded-3xl transition-colors duration-300 pointer-events-none"></div>
              </button>
            ))}
          </div>
        </div>
      ))}

    </div>
  </section>

  <div id="gallery-lightbox" class="fixed inset-0 z-[100] hidden bg-black/90 p-4 sm:p-8" role="dialog" aria-modal="true" aria-label="Full size gallery image">
    <button id="gallery-lightbox-close" type="button" class="absolute right-4 top-4 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur transition hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-white" aria-label="Close full size image">
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
    <div class="flex h-full w-full items-center justify-center">
      <img id="gallery-lightbox-image" src="" alt="" class="max-h-full max-w-full rounded-lg object-contain shadow-2xl" />
    </div>
  </div>
</Layout>

<script>
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImage = document.getElementById('gallery-lightbox-image');
  const closeButton = document.getElementById('gallery-lightbox-close');
  const galleryButtons = document.querySelectorAll('.gallery-image');

  const closeLightbox = () => {
    if (!lightbox || !lightboxImage) return;
    lightbox.classList.add('hidden');
    document.body.style.overflow = '';
    lightboxImage.setAttribute('src', '');
    lightboxImage.setAttribute('alt', '');
  };

  galleryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (!lightbox || !lightboxImage) return;
      const src = button.getAttribute('data-full-src') || '';
      const alt = button.getAttribute('data-alt') || '';

      lightboxImage.setAttribute('src', src);
      lightboxImage.setAttribute('alt', alt);
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      closeButton?.focus();
    });
  });

  closeButton?.addEventListener('click', closeLightbox);

  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) {
      closeLightbox();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && lightbox && !lightbox.classList.contains('hidden')) {
      closeLightbox();
    }
  });
</script>
