        <span>Sharad Dayalji Pandhi</span><span class="w-2 h-2 rounded-full bg-orange-300"></span>
        <span>Chhaya Sakharkar</span><span class="w-2 h-2 rounded-full bg-orange-300"></span>
        <span>Mangesh Mahesh Joshi</span><span class="w-2 h-2 rounded-full bg-orange-300"></span>
        <span>Everest Infrastructure & Developers</span><span class="w-2 h-2 rounded-full bg-orange-300"></span>
        <span>Hemant Singh</span><span class="w-2 h-2 rounded-full bg-orange-300"></span>
