---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us | Shashvat Paediatric Care Foundation">
  <!-- Page Header -->
  <div class="relative bg-slate-950 py-8 sm:py-10 overflow-hidden border-b border-orange-900/30">
    <div class="absolute inset-0 bg-[url('/assets/images/tmh.jpg')] bg-cover bg-center opacity-10 mix-blend-luminosity"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/80 to-transparent"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 font-bold text-xs mb-4 uppercase tracking-widest backdrop-blur-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-pulse"></span>
        Discover Our Story
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-4">About Us</h1>
      <p class="text-lg text-slate-300 max-w-3xl mx-auto leading-relaxed">Learn about our vision, our dedicated team, and the programs we run to support children battling cancer.</p>
    </div>
  </div>

  <!-- Our Vision Section -->
  <section class="py-24 bg-white overflow-hidden relative">
    <div class="absolute top-0 right-0 w-1/2 h-full bg-orange-50/50 -skew-x-12 transform origin-top translate-x-20"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-center">
        <div class="mb-12 lg:mb-0">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-100 text-orange-700 font-bold text-sm mb-6 uppercase tracking-widest">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>
            Our Vision
          </div>
          <h2 class="text-4xl font-extrabold text-slate-900 tracking-tight sm:text-5xl mb-8 leading-tight">Driven by compassion, fueled by <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-amber-500">action.</span></h2>
          <div class="prose prose-lg text-slate-600 prose-a:text-orange-600 hover:prose-a:text-orange-500">
            <p class="lead text-xl text-slate-700 font-medium mb-6">
              Shashvat Paediatric Care Foundation is a volunteer-driven organization where every donation directly supports pediatric cancer patients.
            </p>
            <p class="mb-6">
              Our volunteers manage all tasks independently, ensuring no additional financial burden is placed on the Trust. We operate with zero overhead costs, allowing 100% of the donations to go directly to patient care.
            </p>
            <p class="mb-6">
              We began our journey in collaboration with the National Cancer Institute, Nagpur, where we provided financial support to pediatric patients from underprivileged families. The Social Work Department identifies the needy patients, and we pay directly to the hospital to cover their treatment costs. To date, we are proud to have supported 8 patients and their families in accessing cancer treatment.
            </p>
            <div class="bg-orange-50 border-l-4 border-orange-500 p-6 rounded-r-2xl my-8">
              <p class="mb-0 text-slate-700 font-medium">
                We are fortunate to have partnered with Tata Memorial Hospital, Mumbai and National Cancer Institute, Nagpur. As of now, we have supported more than 50 pediatric patients with their diagnostic expenses.
              </p>
            </div>
            <p>
              Recognizing that some families struggle even for basic necessities, we extend our support to cover lodging and boarding for these families at Shri Gadge Baba Trust in Sion, Mumbai, which is conveniently located near Tata Memorial Hospital.
            </p>
          </div>
        </div>
        <div class="relative group">
          <div class="absolute -inset-4 bg-gradient-to-r from-orange-400 to-amber-400 rounded-[3rem] opacity-30 group-hover:opacity-50 transition duration-500 blur-2xl"></div>
          <div class="relative rounded-[2.5rem] overflow-hidden shadow-2xl border-4 border-white transform transition-transform duration-700 group-hover:scale-[1.02]">
            <img src="/assets/images/mission.png" alt="Our Vision" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/40 to-transparent mix-blend-overlay"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Team -->
  <section id="ourTeam" class="py-24 bg-slate-50 border-y border-slate-200/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-200 text-slate-700 font-bold text-sm mb-4 uppercase tracking-widest">
        <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
        Leadership
      </div>
      <h2 class="text-4xl font-extrabold text-slate-900 sm:text-5xl mb-16">Our Core Team</h2>
      <div class="flex flex-wrap justify-center gap-16">
        <!-- Team Member 1 -->
        <div class="flex flex-col items-center group">
          <div class="w-56 h-56 rounded-full overflow-hidden shadow-xl shadow-orange-900/10 border-4 border-white mb-6 transform group-hover:scale-105 transition duration-500 relative">
            <div class="absolute inset-0 border-4 border-transparent group-hover:border-orange-500/20 rounded-full transition-colors z-10"></div>
            <img src="/assets/images/Sachin-joshi.jpeg" alt="Sachin Joshi" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-1">Sachin Joshi</h3>
          <p class="text-orange-600 font-medium">Core Member</p>
        </div>
        <!-- Team Member 2 -->
        <div class="flex flex-col items-center group">
          <div class="w-56 h-56 rounded-full overflow-hidden shadow-xl shadow-orange-900/10 border-4 border-white mb-6 transform group-hover:scale-105 transition duration-500 relative">
            <div class="absolute inset-0 border-4 border-transparent group-hover:border-orange-500/20 rounded-full transition-colors z-10"></div>
            <img src="/assets/images/Baba.jpeg" alt="Ashok Zamre" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-1">Ashok Zamre</h3>
          <p class="text-orange-600 font-medium">Core Member</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Associates (Marquee) -->
  <section class="py-16 bg-[var(--color-primary)] text-white overflow-hidden relative shadow-inner">
    <div class="absolute inset-0 bg-black/10 mix-blend-overlay"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-10 relative z-10">
      <h2 class="text-3xl font-extrabold tracking-tight">Our Valued Associates</h2>
      <div class="w-24 h-1 bg-white/30 mx-auto mt-4 rounded-full"></div>
    </div>
    <div class="relative w-full flex overflow-x-hidden z-10">
      <div class="animate-[marquee_40s_linear_infinite] whitespace-nowrap py-4 text-xl font-medium text-orange-50 flex gap-8 items-center">
        <span>Kuldeep Kelkar</span><span class="w-2 h-2 rounded-full bg-orange-300"></span>
        <span>Snehal Kelkar</span><span class="w-2 h-2 rounded-full bg-orange-300"></span>
        <span>Yellapantula Venkat</span><span class="w-2 h-2 rounded-full bg-orange-300"></span>
        <span>Jaivardhan Iyer</span><span class="w-2 h-2 rounded-full bg-orange-300"></span>
        <span>Sunil Agarwal</span><span class="w-2 h-2 rounded-full bg-orange-300"></span>
