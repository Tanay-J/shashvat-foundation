---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home | Shashvat Paediatric Care Foundation">
  <!-- Updates Marquee -->
  <div class="bg-[var(--color-primary)] text-orange-50 py-3 overflow-hidden relative shadow-inner">
    <div class="whitespace-nowrap animate-[marquee_25s_linear_infinite] inline-block px-4">
      <span class="text-sm md:text-base font-medium tracking-wide flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
        We are thrilled to share that Shashvat Paediatric Care Foundation has been recognized by Tata Memorial Hospital and ImPACCT Foundation. 
        <a href="/photo_gallery" class="underline decoration-white/70 hover:text-white hover:decoration-white ml-2 font-bold transition-colors">Click here for details!</a>
      </span>
    </div>
  </div>

  <!-- Hero Section -->
  <div class="relative bg-white overflow-hidden min-h-[90vh] flex items-center">
    <div class="absolute inset-0">
      <img src="/assets/images/tmh.jpg" alt="Hero Background" class="w-full h-full object-cover scale-105 animate-[pulse_20s_ease-in-out_infinite_alternate]" />
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
    </div>
    <div class="relative w-full max-w-7xl mx-auto py-20 px-4 sm:py-28 sm:px-6 lg:px-8 flex flex-col items-center text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-white mb-6 animate-fade-in-up">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-primary)] animate-pulse"></span>
        <span class="text-xs font-semibold tracking-wider uppercase">Empowering Communities</span>
      </div>
      <h1 class="text-4xl font-extrabold tracking-tight text-white sm:text-6xl lg:text-7xl drop-shadow-2xl mb-5">
        Together we build <br/><span class="text-[var(--color-primary)]">futures.</span>
      </h1>
      <p class="max-w-xl text-lg sm:text-xl text-orange-50 font-medium drop-shadow-lg mb-8 leading-relaxed">
        Join hands with us to bring hope and change to children battling cancer. Your contribution transforms lives.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
        <a href="/contact_us" class="group inline-flex items-center justify-center px-7 py-3.5 text-base font-bold rounded-full text-white bg-[var(--color-primary)] shadow-xl hover:shadow-[var(--color-primary)]/50 hover:opacity-90 transition-all duration-300 hover:-translate-y-1">
          Support a Child Today
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
        <a href="/about_us" class="inline-flex items-center justify-center px-7 py-3.5 border-2 border-white/80 text-base font-bold rounded-full text-white hover:bg-white hover:text-orange-950 backdrop-blur-sm shadow-xl transition duration-300">
          Learn More
        </a>
      </div>
    </div>
    <!-- Decorative bottom wave -->
    <div class="absolute bottom-0 left-0 right-0 w-full overflow-hidden leading-none">
      <svg class="relative block w-full h-[50px] md:h-[100px]" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V120H0V95.8C59.71,118.08,130.83,119.93,197.36,97.32,242.4,81.9,282.72,67.75,321.39,56.44Z" class="fill-orange-50"></path>
      </svg>
    </div>
  </div>

  <!-- About Us Section -->
  <section class="py-24 bg-orange-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-center">
        <div class="mb-12 lg:mb-0 relative group">
          <!-- decorative background blob -->
          <div class="absolute -inset-4 bg-gradient-to-r from-orange-400 to-amber-400 rounded-[3rem] opacity-30 group-hover:opacity-50 transition duration-500 blur-2xl"></div>
          <img src="/assets/images/home-1.jpg" alt="About Us" class="relative rounded-3xl shadow-2xl object-cover w-full h-[500px] transform transition duration-700 group-hover:scale-[1.02] border-4 border-white/50" />
          
          <!-- Floating stats card -->
          <div class="absolute -bottom-6 -right-6 bg-white p-6 rounded-2xl shadow-xl border border-orange-100 hidden md:block animate-bounce-slow">
            <div class="flex items-center gap-4">
              <div class="bg-orange-100 p-3 rounded-full">
                <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
              </div>
              <div>
                <p class="text-2xl font-black text-slate-800">100%</p>
                <p class="text-sm font-semibold text-slate-500 uppercase">Donation to Patients</p>
              </div>
            </div>
          </div>
        </div>
        <div class="pl-0 lg:pl-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-100 text-orange-700 font-bold text-sm mb-6 uppercase tracking-widest">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>
            Who We Are
          </div>
          <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 mb-6 leading-tight">
            Making a profound <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-amber-500">difference</span> in children's lives.
          </h2>
          <p class="text-lg text-slate-600 mb-6 leading-relaxed">
            Shashvat Paediatric Care Foundation is a voluntary organization dedicated to making a difference in the lives of children battling cancer. Our commitment is unwavering: every penny donated goes directly to the patients we serve.
          </p>
          <p class="text-lg text-slate-600 mb-8 leading-relaxed">
            Our sole purpose is to support paediatric cancer patients from underprivileged families. We provide comprehensive support, covering pre-diagnostic expenses, cancer treatment costs, and lodging & boarding expenses.
          </p>
          <a href="/about_us" class="inline-flex items-center justify-center px-6 py-3 border-2 border-orange-600 text-base font-bold rounded-full text-orange-700 hover:bg-orange-600 hover:text-white transition-all duration-300 group">
            Learn More About Our Mission
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 transform group-hover:translate-x-1 transition" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Impact Metrics -->
  <section class="py-24 bg-white relative">
    <div class="absolute top-0 left-0 w-full h-1/2 bg-orange-50"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-extrabold text-slate-900 mb-4">Our Impact</h2>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto">By partnering with hospitals, caregivers, and communities, we strive to reduce the financial and emotional burden of cancer treatment.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="bg-white rounded-[2rem] shadow-xl shadow-orange-900/5 p-10 text-center transform transition duration-500 hover:-translate-y-2 border border-slate-100 group">
          <div class="w-20 h-20 mx-auto bg-orange-50 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-500 group-hover:bg-orange-100 rotate-3">
            <svg class="w-10 h-10 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-5xl font-black text-slate-900 mb-2">₹22,00,000<span class="text-orange-500">+</span></h3>
          <p class="text-lg text-slate-500 font-bold uppercase tracking-widest mt-4">Total Contribution</p>
        </div>
        <div class="bg-white rounded-[2rem] shadow-xl shadow-orange-900/5 p-10 text-center transform transition duration-500 hover:-translate-y-2 border border-slate-100 group">
          <div class="w-20 h-20 mx-auto bg-amber-50 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-500 group-hover:bg-amber-100 -rotate-3">
            <svg class="w-10 h-10 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
          </div>
          <h3 class="text-5xl font-black text-slate-900 mb-2">50<span class="text-amber-500">+</span></h3>
          <p class="text-lg text-slate-500 font-bold uppercase tracking-widest mt-4">Children Reached</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent Campaigns -->
  <section class="py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-end mb-16">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-100 text-orange-700 font-bold text-sm mb-4 uppercase tracking-widest">
            <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>
            Our Work
          </div>
          <h2 class="text-4xl font-extrabold text-slate-900">Recent Campaigns</h2>
          <p class="mt-4 text-xl text-slate-600">See how your donations are making a direct impact.</p>
        </div>
        <a href="/photo_gallery" class="hidden md:inline-flex items-center text-orange-600 font-bold hover:text-orange-700 group">
          View all campaigns
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 transform group-hover:translate-x-1 transition" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Campaign 1 -->
        <div class="bg-white rounded-3xl shadow-lg shadow-slate-200/50 overflow-hidden group hover:shadow-xl hover:shadow-orange-900/10 transition-all duration-300 border border-slate-100">
          <div class="relative h-60 overflow-hidden">
            <img src="/assets/images/TMH-Donation-Dec-24.jpeg" alt="Campaign 1" class="w-full h-full object-cover transform group-hover:scale-110 transition duration-700" />
            <div class="absolute top-4 right-4 bg-white/90 backdrop-blur text-orange-900 text-xs font-bold px-4 py-1.5 rounded-full shadow-sm z-20">Dec 2024</div>
          </div>
          <div class="p-8">
            <h3 class="text-2xl font-bold text-slate-900 mb-3 group-hover:text-orange-600 transition-colors">₹3,50,000 Donation</h3>
            <p class="text-slate-600 mb-6 leading-relaxed">Donation for treatment of Paediatric Patients</p>
            <div class="flex items-center text-sm font-semibold text-slate-500 bg-slate-50 p-3 rounded-xl">
              <svg class="h-5 w-5 mr-2 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              Tata Memorial Hospital
            </div>
          </div>
        </div>
        <!-- Campaign 2 -->
        <div class="bg-white rounded-3xl shadow-lg shadow-slate-200/50 overflow-hidden group hover:shadow-xl hover:shadow-orange-900/10 transition-all duration-300 border border-slate-100">
          <div class="relative h-60 overflow-hidden">
            <img src="/assets/images/TMC-Donation-June-24.jpeg" alt="Campaign 2" class="w-full h-full object-cover transform group-hover:scale-110 transition duration-700" />
            <div class="absolute top-4 right-4 bg-white/90 backdrop-blur text-orange-900 text-xs font-bold px-4 py-1.5 rounded-full shadow-sm z-20">Jun 2024</div>
          </div>
          <div class="p-8">
            <h3 class="text-2xl font-bold text-slate-900 mb-3 group-hover:text-orange-600 transition-colors">₹2,25,000 Donation</h3>
            <p class="text-slate-600 mb-6 leading-relaxed">Donation for treatment of 5 Paediatric Patients</p>
            <div class="flex items-center text-sm font-semibold text-slate-500 bg-slate-50 p-3 rounded-xl">
              <svg class="h-5 w-5 mr-2 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              Tata Memorial Hospital
            </div>
          </div>
        </div>
        <!-- Campaign 3 -->
        <div class="bg-white rounded-3xl shadow-lg shadow-slate-200/50 overflow-hidden group hover:shadow-xl hover:shadow-orange-900/10 transition-all duration-300 border border-slate-100">
          <div class="relative h-60 overflow-hidden">
            <img src="/assets/images/e3.jpg" alt="Campaign 3" class="w-full h-full object-cover transform group-hover:scale-110 transition duration-700" />
            <div class="absolute top-4 right-4 bg-white/90 backdrop-blur text-orange-900 text-xs font-bold px-4 py-1.5 rounded-full shadow-sm z-20">Mar 2024</div>
          </div>
          <div class="p-8">
            <h3 class="text-2xl font-bold text-slate-900 mb-3 group-hover:text-orange-600 transition-colors">₹2,50,000 Donation</h3>
            <p class="text-slate-600 mb-6 leading-relaxed">Donation for treatment of 5 Paediatric Patients</p>
            <div class="flex items-center text-sm font-semibold text-slate-500 bg-slate-50 p-3 rounded-xl">
              <svg class="h-5 w-5 mr-2 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              Tata Memorial Hospital
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  @keyframes marquee {
    0% { transform: translateX(100%); }
    100% { transform: translateX(-100%); }
  }
  .animate-\[marquee_25s_linear_infinite\] {
    animation: marquee 25s linear infinite;
  }
  
  @keyframes bounce-slow {
    0%, 100% {
      transform: translateY(-5%);
      animation-timing-function: cubic-bezier(0.8,0,1,1);
    }
    50% {
      transform: none;
      animation-timing-function: cubic-bezier(0,0,0.2,1);
    }
  }
  .animate-bounce-slow {
    animation: bounce-slow 3s infinite;
  }
</style>
