---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Shashvat Paediatric Care Foundation", 
  description = "Shashvat Paediatric Care Foundation is dedicated to making a difference in the lives of children battling cancer." 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="/assets/images/fav.jpg" type="image/x-icon" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="antialiased text-slate-800 bg-gradient-to-br from-orange-50 via-white to-amber-50 min-h-screen flex flex-col selection:bg-orange-200 selection:text-orange-900">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
